CREATE TABLE usuarios (
    ID INT GENERATED BY DEFAULT AS IDENTITY,
    nome VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    senha VARCHAR(255) NOT NULL,
    nivel BOOLEAN NOT NULL,
    PRIMARY KEY (ID)
);

COMMENT ON COLUMN usuarios.senha IS 'Hash da senha gerado pela aplicacao';

CREATE TABLE categorias (
    ID INT GENERATED BY DEFAULT AS IDENTITY,
    nome VARCHAR(255) NOT NULL,
    PRIMARY KEY (ID)
);

CREATE TABLE produto (
    ID INT GENERATED BY DEFAULT AS IDENTITY,
    ID_categoria INT NOT NULL,
    Quantidade INT NOT NULL,
    Largura REAL NULL,
    Comprimento REAL NULL,
    tamanho VARCHAR(50) NULL,
    grossura VARCHAR(3) NULL,
    acabamento VARCHAR(20) NULL,
    tipo VARCHAR(50) NULL,
    PRIMARY KEY (ID),
    CONSTRAINT fk_produto_categoria
        FOREIGN KEY (ID_categoria) REFERENCES categorias (ID)
);

CREATE TABLE pedido (
    ID INT GENERATED BY DEFAULT AS IDENTITY,
    ID_usuario INT NOT NULL,
    ID_produto INT NOT NULL,
    data TIMESTAMP WITHOUT TIME ZONE NOT NULL,
    status VARCHAR(50) NOT NULL,
    PRIMARY KEY (ID),
    CONSTRAINT fk_pedido_usuario
        FOREIGN KEY (ID_usuario) REFERENCES usuarios (ID),
    CONSTRAINT fk_pedido_produto
        FOREIGN KEY (ID_produto) REFERENCES produto (ID)
);

CREATE TABLE carrinho (
    ID INT GENERATED BY DEFAULT AS IDENTITY,
    ID_usuario INT NOT NULL,
    ID_pedido INT NOT NULL,
    PRIMARY KEY (ID),
    CONSTRAINT fk_carrinho_usuario
        FOREIGN KEY (ID_usuario) REFERENCES usuarios (ID),
    CONSTRAINT fk_carrinho_pedido
        FOREIGN KEY (ID_pedido) REFERENCES pedido (ID)
);
